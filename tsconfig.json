{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "#": [
        "./src"
      ],
      "#/*": [
        "./src/*"
      ],
      "#components": ["./src/components"],
      "#components/*": ["./src/components/*"],
      "#constants": ["./src/constants"],
      "#constants/*": ["./src/constants/*"],
      "#theme": ["./src/theme"],
      "#theme/*": ["./src/theme/*"],
      "#assets": ["./src/assets"],
      "#assets/*": ["./src/assets/*"],
      "#utils": ["./src/utils"],
      "#utils/*": ["./src/utils/*"],
      "#types": ["./src/types"],
      "#types/*": ["./src/types/*"],
      "#lang": ["./src/lang"],
      "#lang/*": ["./src/lang/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}